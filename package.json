{
  "name": "project-eclipse",
  "version": "0.33.0",
  "private": true,
  "description": "A tactical multiplayer FPS with combat-capable server-authoritative bots, map collision and private lobbies",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "server": "node server/server.js",
    "start": "concurrently -k \"npm:server\" \"npm:dev\"",
    "start:production": "node server/server.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^7.1.12"
  }
}
